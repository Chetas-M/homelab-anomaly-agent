FROM python:3.12-slim

WORKDIR /app

# Install build dependencies for psycopg2 and numpy/scipy if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install dependencies needed for inference
RUN pip install --no-cache-dir pandas==2.2.1 scikit-learn==1.8.0 numpy==1.26.4 joblib==1.3.2 SQLAlchemy==2.0.29 psycopg2-binary==2.9.9 python-dotenv==1.0.1

COPY ./api /app/api
COPY ./analysis /app/analysis
COPY ./scripts /app/scripts
COPY ./models /app/models

CMD ["python", "scripts/live_inference.py"]
